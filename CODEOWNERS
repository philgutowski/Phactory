# Paths where a change waits for one review even with auto merge on (KTD25).
# A change here either lands on the host holding every customer credential or
# needs a live smoke only the operator can run. The ruleset on main requires
# code owner review, so these lines are the review rule.

/.github/                   @philgutowski
/factory/                   @philgutowski
/deploy/                    @philgutowski
/src/slipway/config/       @philgutowski
/src/slipway/auth.py       @philgutowski
/src/slipway/redact.py     @philgutowski
/src/slipway/mcp/          @philgutowski
/src/slipway/hosts/        @philgutowski
/src/slipway/builders/     @philgutowski
/src/slipway/trace/        @philgutowski
/src/slipway/evals/        @philgutowski
/src/slipway/onboard/      @philgutowski
/src/slipway/runner/       @philgutowski

# Not in KTD25's list: this file itself. Without this line an auto merged
# change could delete the rule above without anyone reading it.
/CODEOWNERS                 @philgutowski
